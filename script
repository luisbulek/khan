
 // ==UserScript==
 // @name         Khan Helper - LuisBulek 3.2
 // @namespace    https://github.com/luisbulek/khan
 // @version      3.2.0
 // @description  Detecta alternativas, resolve alguns logaritmos e so avanca apos acerto confirmado.
 // @match        https://*.khanacademy.org/*
 // @match        https://khanacademy.org/*
 // @run-at       document-start
 // @grant        none
 // ==/UserScript==

(() => {
  'use strict';
  const KEY = '__LB_KHAN_32__';
  if (window[KEY]) return;
  window[KEY] = true;

  const st = {
    active: false,
    phase: 'idle',
    message: 'Analisando pagina...',
    source: '',
    answer: '',
    answeredFingerprint: '',
    since: Date.now(),
    lastClick: 0,
    lastAnalyze: 0,
    captured: [],
    network: 0
  };

  const log = (...v) => console.info('[Khan 3.2]', ...v);

  const norm = s => String(s || '')
    .replace(/\\(?:text|mathrm)\s*\{([^{}]*)\}/g, '$1')
    .replace(/\*\*/g, '')
    .replace(/\s+/g, ' ')
    .replace(/[,]/g, '.')
    .replace(/[^\p{L}\p{N}.+\-/%= ]/gu, '')
    .trim()
    .toLowerCase();

  const visible = e => !!(
    e &&
    e.isConnected &&
    e.getClientRects().length &&
    !e.disabled &&
    e.getAttribute('aria-disabled') !== 'true'
  );

  function status(message) {
    if (st.message !== message) log(message);
    st.message = message;

    const el = document.getElementById('lb32-status');
    if (el) el.textContent = message;

    const meta = document.getElementById('lb32-meta');

    if (meta) {
      meta.textContent =
        `Fonte: ${st.source || 'nenhuma'} · Dados: ${st.network}`;
    }
  }

  function phase(name, message) {
    st.phase = name;
    st.since = Date.now();
    if (message) status(message);
  }

  function collectData(data) {
    const results = Array.isArray(data) ? data : [data];

    for (const result of results) {
      const attempt = result?.data?.attemptProblem?.result;
      const verdict =
        attempt?.actionResults?.attemptCorrect ??
        attempt?.attemptCorrect;

      if (st.phase === 'checking' &&
          typeof verdict === 'boolean') {
        if (verdict) {
          phase('correct', 'Acerto confirmado pela plataforma.');
        } else {
          st.active = false;
          phase('paused', 'Resposta rejeitada pela plataforma.');
        }
      }
    }

    let count = 0;
    const seen = new WeakSet();

    function walk(obj, depth) {
      if (!obj ||
          typeof obj !== 'object' ||
          seen.has(obj) ||
          depth > 12) return;

      seen.add(obj);

      if (typeof obj.itemData === 'string') {
        try {
          const q = JSON.parse(obj.itemData)?.question;

          for (const [key, w] of Object.entries(q?.widgets || {})) {
            if (w?.type !== 'radio' ||
                w.options?.multipleSelect) continue;

            if (typeof q.content === 'string' &&
                !q.content.includes('☃ ' + key)) continue;

            const choices = w.options?.choices;
            if (!Array.isArray(choices)) continue;

            const correct = choices.filter(
              c => c?.correct === true
            );

            if (correct.length !== 1) continue;

            const entry = {
              options: choices.map(c => norm(c.content)),
              correct: norm(correct[0].content)
            };

            if (!entry.correct) continue;

            st.captured.push(entry);
            count++;
          }
        } catch (e) {
          log('Item ignorado:', e.message);
        }
      }

      if (Array.isArray(obj)) {
        obj.forEach(v => walk(v, depth + 1));
      } else {
        Object.values(obj).forEach(v => walk(v, depth + 1));
      }
    }

    walk(data, 0);

    st.captured = st.captured.slice(-30);
    st.network += count;

    if (count) {
      status(`${count} resposta(s) identificada(s) no carregamento.`);
    }
  }

  const origFetch = window.fetch;

  if (typeof origFetch === 'function') {
    window.fetch = async function(...args) {
      const response = await origFetch.apply(this, args);

      try {
        const url = args[0] instanceof Request
          ? args[0].url
          : String(args[0]);

        if (/getAssessmentItem|attemptProblem|graphql/i.test(url) &&
            response.ok &&
            (response.headers.get('content-type') || '')
              .includes('json')) {

          response.clone().json()
            .then(collectData)
            .catch(() => {});
        }
      } catch (e) {
        log('Fetch:', e.message);
      }

      return response;
    };
  }

  function options() {
    const containers = document.querySelectorAll(
      '.perseus-widget-radio, ' +
      '.perseus-radio-option-list, ' +
      '[role="radiogroup"], fieldset'
    );

    for (const c of containers) {
      if (!visible(c)) continue;

      for (const selector of [
        '.perseus-radio-option',
        'li',
        'label',
        '[role="radio"]'
      ]) {
        const elements = [...c.querySelectorAll(selector)]
          .filter(visible);

        const outer = elements.filter(
          e => !elements.some(
            other => other !== e && e.contains(other)
          )
        );

        if (outer.length >= 2 && outer.length <= 8) {
          return outer.map(e => ({
            el: e,
            text: (e.innerText || e.textContent || '').trim()
          }));
        }
      }
    }

    const all = [
      ...document.querySelectorAll(
        'label, [role="radio"], .perseus-radio-option'
      )
    ].filter(visible)
      .filter(e => (e.innerText || '').trim().length > 1);

    const unique = all.filter(
      e => !all.some(
        other => other !== e && other.contains(e)
      )
    );

    if (unique.length >= 2 && unique.length <= 8) {
      return unique.map(e => ({
        el: e,
        text: (e.innerText || e.textContent || '').trim()
      }));
    }

    const root = document.querySelector('main') || document.body;
    const letters = new Map();

    for (const e of root.querySelectorAll(
      'button, [role="radio"], [tabindex]'
    )) {
      if (!visible(e)) continue;

      const label = (
        e.innerText ||
        e.getAttribute('aria-label') ||
        ''
      ).trim().toUpperCase();

      if (!/^[A-H]$/.test(label)) continue;

      const row = e.closest(
        'label, li, [role="radio"], .perseus-radio-option'
      ) || e.parentElement;

      const text = (row?.innerText || '').trim();

      if (text.length > 2 && text.length < 120) {
        letters.set(label, { el: e, text });
      }
    }

    return letters.size >= 2
      ? [...letters]
          .sort((a, b) => a[0].localeCompare(b[0]))
          .map(x => x[1])
      : [];
  }

  function textArea() {
    const root =
      document.querySelector('.perseus-renderer') ||
      document.querySelector('main') ||
      document.body;

    return (root?.innerText || '').slice(0, 16000);
  }

  function numericOption(text) {
    const clean = text
      .replace(/^\s*[A-H][.):]?\s+/i, '')
      .replace(',', '.');

    const found = clean.match(/[-+]?\d+(?:\.\d+)?/);

    return found ? Number(found[0]) : NaN;
  }

  function logSolver(text) {
    const known = new Map([[10, 1]]);

    const pattern =
      /log\s*(\d+)\s*=\s*([+-]?\d+(?:[.,]\d+)?)/gi;

    for (const m of text.matchAll(pattern)) {
      known.set(
        Number(m[1]),
        Number(m[2].replace(',', '.'))
      );
    }

    if (known.has(5)) {
      known.set(2, 1 - known.get(5));
    }

    const targetMatch = text.match(
      /(?:calcule|determine|valor\s+de)[^\n]{0,80}?log\s*(\d+)/i
    );

    if (!targetMatch) return null;

    const target = Number(targetMatch[1]);

    if (!Number.isSafeInteger(target) || target <= 0) {
      return null;
    }

    let n = target;
    let total = 0;

    for (let p = 2; p <= n && p < 10000; p++) {
      if (n % p !== 0) continue;
      if (!known.has(p)) return null;

      while (n % p === 0) {
        total += known.get(p);
        n /= p;
      }
    }

    return n === 1
      ? Number(total.toFixed(6))
      : null;
  }

  function resolve(list) {
    const opts = list.map(o =>
      norm(o.text).replace(/^[a-h]\s+/, '')
    );

    for (const captured of st.captured.slice().reverse()) {
      const overlap = opts.filter(t =>
        captured.options.some(x =>
          x === t ||
          x.endsWith(' ' + t) ||
          t.endsWith(' ' + x)
        )
      ).length;

      if (overlap < Math.min(2, list.length)) continue;

      const indexes = opts.map((t, i) =>
        t === captured.correct ||
        t.endsWith(' ' + captured.correct) ||
        captured.correct.endsWith(' ' + t)
          ? i
          : -1
      ).filter(i => i >= 0);

      if (indexes.length === 1) {
        return {
          index: indexes[0],
          source: 'dados da questao'
        };
      }
    }

    const calculated = logSolver(textArea());

    if (calculated !== null) {
      const matches = list.map((o, i) =>
        Math.abs(numericOption(o.text) - calculated) < 0.000001
          ? i
          : -1
      ).filter(i => i >= 0);

      if (matches.length === 1) {
        return {
          index: matches[0],
          source: 'calculo de logaritmo'
        };
      }
    }

    return null;
  }

  function button(ids, labels) {
    for (const id of ids) {
      const b = document.querySelector(
        `[data-testid="${id}"]`
      );

      if (visible(b)) return b;
    }

    return [...document.querySelectorAll('button')]
      .find(b =>
        visible(b) &&
        labels.includes(
          (b.innerText || '').trim().toLowerCase()
        )
      ) || null;
  }

  const check = () => button(
    ['exercise-check-answer'],
    [
      'verificar',
      'verificar resposta',
      'conferir',
      'check answer'
    ]
  );

  const next = () => button(
    [
      'exercise-next-question',
      'exercise-next-question-button'
    ],
    [
      'próxima questão',
      'próximo',
      'continuar',
      'next question'
    ]
  );

  function fingerprint(list) {
    return norm(textArea()).slice(0, 1000) +
      '##' +
      list.map(o => norm(o.text)).join('||');
  }

  function clickOption(entry) {
    const el = entry.el;

    const input = el.matches('input, [role="radio"]')
      ? el
      : el.querySelector(
          'input[type="radio"], [role="radio"]'
        );

    const target = input ||
      el.querySelector('label, button, .description') ||
      el;

    target.click();
  }

  function analyze() {
    const list = options();

    if (list.length < 2) {
      status('Nao encontrei alternativas na tela.');
      return;
    }

    const answer = resolve(list);

    if (!answer) {
      status(
        `${list.length} alternativas encontradas, ` +
        'mas sem resposta verificavel. Nao vou chutar.'
      );
      return;
    }

    const fp = fingerprint(list);

    st.source = answer.source;
    st.answer = String.fromCharCode(65 + answer.index);

    if (fp === st.answeredFingerprint) {
      status(`Questao ja selecionada: ${st.answer}.`);
      return;
    }

    clickOption(list[answer.index]);

    st.answeredFingerprint = fp;
    st.lastClick = Date.now();

    phase(
      'selected',
      `Resposta ${st.answer} selecionada (${answer.source}).`
    );
  }

  function tick() {
    if (!st.active ||
        document.visibilityState === 'hidden') return;

    if (Date.now() - st.lastClick < 1400) return;

    if (st.phase === 'idle') {
      if (Date.now() - st.lastAnalyze < 3000) return;

      st.lastAnalyze = Date.now();
      analyze();
      return;
    }

    if (st.phase === 'selected') {
      const b = check();

      if (b) {
        st.lastClick = Date.now();
        b.click();

        phase(
          'checking',
          'Resposta enviada; aguardando resultado visivel.'
        );
      }

      return;
    }

    if (st.phase === 'checking') {
      const screen = (
        document.body?.innerText || ''
      ).toLowerCase();

      const success =
        /(?:resposta correta|muito bem|parab[eé]ns|correct answer|resposta certa|mandou bem|voce acertou|você acertou|acertou!)/i
          .test(screen);

      if (success && next()) {
        phase(
          'correct',
          'Acerto exibido pela plataforma.'
        );
      } else if (Date.now() - st.since > 12000) {
        st.active = false;

        phase(
          'paused',
          'Sem confirmacao de acerto. Pausado para evitar pular questoes.'
        );
      }

      return;
    }

    if (st.phase === 'correct') {
      const b = next();

      if (b) {
        st.lastClick = Date.now();
        b.click();

        phase(
          'transition',
          'Avancando apos acerto confirmado.'
        );
      }

      return;
    }

    if (st.phase === 'transition') {
      const current = options();

      if (
        current.length >= 2 &&
        fingerprint(current) !== st.answeredFingerprint
      ) {
        phase('idle', 'Nova questao detectada.');
      }
    }
  }

  function panel() {
    if (!document.body ||
        document.getElementById('lb32-panel')) return;

    const p = document.createElement('section');
    p.id = 'lb32-panel';

    p.style.cssText =
      'position:fixed;top:85px;right:16px;width:260px;' +
      'z-index:2147483646;background:#123225;color:#e4fff0;' +
      'padding:14px;border-radius:12px;' +
      'box-shadow:0 5px 20px #0006;' +
      'font:13px Arial,sans-serif;';

    const title = document.createElement('strong');
    title.textContent = 'KHAN HELPER 3.2';

    const line = document.createElement('p');
    line.id = 'lb32-status';
    line.textContent = st.message;

    const meta = document.createElement('p');
    meta.id = 'lb32-meta';
    meta.style.cssText = 'font-size:11px;opacity:.8';
    meta.textContent = 'Fonte: nenhuma · Dados: 0';

    const mk = (text, fn) => {
      const b = document.createElement('button');

      b.textContent = text;

      b.style.cssText =
        'background:#21ad70;border:0;border-radius:7px;' +
        'padding:9px;margin-right:6px;margin-bottom:6px;' +
        'cursor:pointer;color:#032015;';

      b.onclick = fn;
      return b;
    };

    const start = mk('Iniciar', () => {
      st.active = !st.active;

      if (
        st.active &&
        ['paused', 'idle'].includes(st.phase)
      ) {
        st.phase = 'idle';
      }

      start.textContent = st.active
        ? 'Pausar'
        : 'Iniciar';

      status(
        st.active
          ? 'Automacao iniciada.'
          : 'Automacao pausada.'
      );
    });

    const scan = mk(
      'Analisar questao',
      () => analyze()
    );

    p.append(title, line, meta, start, scan);
    document.body.appendChild(p);

    status(
      'Pronto. Clique em Analisar questao ou Iniciar.'
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      panel,
      { once: true }
    );
  } else {
    panel();
  }

  setInterval(() => {
    try {
      tick();
    } catch (e) {
      st.active = false;
      console.error('[Khan 3.2]', e);
      status('Erro: ' + e.message);
    }
  }, 1000);
})();
