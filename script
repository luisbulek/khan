
 // ==UserScript==
 // @name         Khan Helper - LuisBulek 3.3
 // @namespace    https://github.com/luisbulek/khan
 // @version      3.3.0
 // @description  Mostra somente a resposta identificada como A; seleciona, verifica e avanca apos acerto.
 // @match        https://*.khanacademy.org/*
 // @match        https://khanacademy.org/*
 // @grant        none
 // @run-at       document-start
 // ==/UserScript==

(() => {
  'use strict';
  if (window.__LB_KHAN_33__) return;
  window.__LB_KHAN_33__ = true;

  const state = {
    running: false,
    phase: 'idle',
    since: Date.now(),
    lastClick: 0,
    lastScan: 0,
    message: 'Abra uma questao de multipla escolha.',
    answers: [],
    capturedCount: 0,
    source: '-',
    current: null,
    beforeFeedback: ''
  };

  const log = (...args) => console.info('[Khan Helper 3.3]', ...args);
  const visible = el => Boolean(el && el.isConnected &&
    el.getClientRects().length && !el.disabled &&
    el.getAttribute('aria-disabled') !== 'true');

  function normalize(value) {
    return String(value || '')
      .replace(/\\(?:text|mathrm)\s*\{([^{}]*)\}/g, '$1')
      .replace(/\*\*/g, '')
      .replace(/\u00a0/g, ' ')
      .replace(/,/g, '.')
      .replace(/\s+/g, ' ')
      .replace(/[^\p{L}\p{N}.+\-/%= ]/gu, '')
      .trim().toLowerCase();
  }

  function tell(message) {
    if (state.message !== message) log(message);
    state.message = message;
    const status = document.getElementById('lb33-status');
    if (status) status.textContent = message;
    const meta = document.getElementById('lb33-meta');
    if (meta) meta.textContent = `Fonte: ${state.source} | Respostas detectadas: ${state.capturedCount}`;
  }

  function setPhase(next, message) {
    state.phase = next;
    state.since = Date.now();
    if (message) tell(message);
  }

  // Somente observa as respostas da rede. Nao falsifica requisicoes nem notas.
  function inspectJSON(payload) {
    if (!payload || typeof payload !== 'object') return;
    const seen = new WeakSet();
    const newlyFound = [];

    function walk(node, depth) {
      if (!node || typeof node !== 'object' || seen.has(node) || depth > 12) return;
      seen.add(node);

      const attempt = node?.attemptProblem?.result || node?.result;
      const verdict = attempt?.actionResults?.attemptCorrect ?? attempt?.attemptCorrect;
      if (state.phase === 'checking' && typeof verdict === 'boolean') {
        if (verdict) setPhase('correct', 'Resposta correta confirmada pelo Khan Academy.');
        else {
          state.running = false;
          setPhase('paused', 'Resposta rejeitada. Automacao pausada.');
          updateStart();
          restoreOptions();
        }
      }

      if (typeof node.itemData === 'string') {
        try {
          const question = JSON.parse(node.itemData)?.question;
          const widgets = question?.widgets || {};
          for (const [key, widget] of Object.entries(widgets)) {
            if (widget?.type !== 'radio' || widget.options?.multipleSelect) continue;
            if (typeof question?.content === 'string' &&
                !question.content.includes('☃ ' + key)) continue;
            const choices = widget.options?.choices;
            if (!Array.isArray(choices) || choices.length < 2) continue;
            const correct = choices.filter(c => c?.correct === true);
            if (correct.length !== 1) continue;
            newlyFound.push({
              values: choices.map(c => normalize(c.content)),
              correct: normalize(correct[0].content)
            });
          }
        } catch (e) { log('Dados ignorados:', e.message); }
      }
      if (Array.isArray(node)) node.forEach(x => walk(x, depth + 1));
      else Object.values(node).forEach(x => walk(x, depth + 1));
    }

    walk(payload, 0);
    if (newlyFound.length) {
      state.answers.push(...newlyFound);
      state.answers = state.answers.slice(-25);
      state.capturedCount += newlyFound.length;
      tell('Dados de resposta recebidos.');
    }
  }

  const originalFetch = window.fetch;
  if (typeof originalFetch === 'function') {
    window.fetch = async function(...args) {
      const response = await originalFetch.apply(this, args);
      try {
        const url = args[0] instanceof Request ? args[0].url : String(args[0]);
        const type = response.headers.get('content-type') || '';
        if (response.ok && /json/i.test(type) &&
            /graphql|assessment|exercise|attemptproblem/i.test(url)) {
          response.clone().json().then(inspectJSON).catch(() => {});
        }
      } catch (e) { log('Fetch:', e.message); }
      return response;
    };
  }

  // Alguns exercicios utilizam XMLHttpRequest em vez de fetch.
  const oldOpen = XMLHttpRequest.prototype.open;
  const oldSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function(method, url, ...rest) {
    this.__lb33URL = String(url || '');
    return oldOpen.call(this, method, url, ...rest);
  };
  XMLHttpRequest.prototype.send = function(...args) {
    if (/graphql|assessment|exercise|attemptproblem/i.test(this.__lb33URL || '')) {
      this.addEventListener('load', () => {
        try {
          if (this.status < 200 || this.status >= 300) return;
          const data = this.responseType === 'json'
            ? this.response
            : JSON.parse(this.responseText);
          inspectJSON(data);
        } catch { /* resposta nao era JSON */ }
      }, { once: true });
    }
    return oldSend.apply(this, args);
  };

  function optionText(element) {
    return (element.innerText || element.textContent || '').trim();
  }

  function rowData(rows) {
    if (rows.length < 2 || rows.length > 8) return [];
    const uniq = [...new Set(rows)];
    return uniq.map(el => ({ el, text: optionText(el) }))
      .filter(x => x.text.length > 0);
  }

  function getOptions() {
    const roots = document.querySelectorAll(
      '.perseus-widget-radio, .perseus-radio-option-list, ' +
      '[role="radiogroup"], [data-testid*="radio"], fieldset'
    );
    for (const root of roots) {
      if (!visible(root) || root.closest('#lb33-panel')) continue;
      for (const sel of [':scope > li', ':scope > label',
        '.perseus-radio-option', 'li', 'label', '[role="radio"]']) {
        const found = [...root.querySelectorAll(sel)].filter(visible);
        const outer = found.filter(el => !found.some(other =>
          other !== el && other.contains(el)));
        const rows = rowData(outer);
        if (rows.length >= 2 && rows.length <= 8) return rows;
      }
    }

    // Versoes novas que exibem A/B/C/D em botoes ou circulos.
    const root = document.querySelector('main') || document.body;
    const byLetter = new Map();
    for (const el of root.querySelectorAll(
      'button, [role="radio"], [tabindex], label'
    )) {
      if (!visible(el) || el.closest('#lb33-panel')) continue;
      const label = (el.getAttribute('aria-label') || optionText(el)).trim();
      if (!/^[A-H]$/i.test(label)) continue;
      let row = el;
      for (let i = 0; i < 3 && row.parentElement; i++) {
        const candidate = row.parentElement;
        const text = optionText(candidate);
        if (text.length > 2 && text.length < 220) {
          row = candidate;
          break;
        }
        row = candidate;
      }
      const text = optionText(row);
      if (text.length >= 3 && text.length < 220) {
        byLetter.set(label.toUpperCase(), { el: row, text });
      }
    }
    if (byLetter.size >= 2 && byLetter.size <= 8) {
      const entries = [...byLetter.entries()]
        .sort((a, b) => a[0].localeCompare(b[0]));
      const rows = entries.map(x => x[1]);
      if (new Set(rows.map(x => x.el)).size === rows.length) return rows;
    }
    return [];
  }

  function exerciseText() {
    const root = document.querySelector('.perseus-renderer') ||
      document.querySelector('[data-testid="exercise-problem"]') ||
      document.querySelector('main') || document.body;
    return (root?.innerText || '').slice(0, 16000);
  }

  function fingerprint(rows) {
    return normalize(exerciseText()).slice(0, 1400) + '##' +
      rows.map(x => normalize(x.text)).join('|');
  }

  // Solucionador restrito a produtos/quocientes/potencias de logaritmos decimais.
  function solveLog(text) {
    const known = new Map([[10, 1]]);
    for (const m of text.matchAll(/log\s*(\d+)\s*=\s*([+-]?\d+(?:[.,]\d+)?)/gi)) {
      known.set(Number(m[1]), Number(m[2].replace(',', '.')));
    }
    if (known.has(5)) known.set(2, 1 - known.get(5));
    const match = text.match(/(?:calcule|determine|valor\s+de)[^\n]{0,100}?log\s*(\d+)/i);
    if (!match) return null;
    let n = Number(match[1]);
    if (!Number.isSafeInteger(n) || n <= 0 || n > 10000000) return null;
    let result = 0;
    for (let p = 2; p * p <= n; p++) {
      if (n % p !== 0) continue;
      if (!known.has(p)) return null;
      while (n % p === 0) { result += known.get(p); n /= p; }
    }
    if (n > 1) {
      if (!known.has(n)) return null;
      result += known.get(n);
    }
    return Number(result.toFixed(7));
  }

  function valueOfOption(text) {
    const clean = text.replace(/^\s*[A-H][.)\s:-]+/i, '').replace(',', '.');
    const match = clean.match(/[-+]?\d+(?:\.\d+)?/);
    return match ? Number(match[0]) : NaN;
  }

  function identify(rows) {
    const labels = rows.map(x => normalize(x.text).replace(/^[a-h]\s+/, ''));
    for (const entry of state.answers.slice().reverse()) {
      const overlap = labels.filter(label => entry.values.some(v =>
        v === label || v.endsWith(' ' + label) || label.endsWith(' ' + v))).length;
      if (overlap < Math.max(2, Math.ceil(rows.length * 0.75))) continue;
      const matches = labels.map((label, i) =>
        label === entry.correct || label.endsWith(' ' + entry.correct) ||
        entry.correct.endsWith(' ' + label) ? i : -1).filter(i => i >= 0);
      if (matches.length === 1) return { index: matches[0], via: 'dados da questao' };
    }
    const computed = solveLog(exerciseText());
    if (computed !== null) {
      const matches = rows.map((r, i) =>
        Math.abs(valueOfOption(r.text) - computed) < 1e-6 ? i : -1)
        .filter(i => i >= 0);
      if (matches.length === 1) return { index: matches[0], via: 'calculo de logaritmo' };
    }
    return null;
  }

  function choose(row) {
    const el = row.el;
    const input = el.matches('input, [role="radio"]') ? el :
      el.querySelector('input[type="radio"], [role="radio"]');
    const target = input || el.querySelector('button, label') || el;
    target.click();
  }

  // O aluno ve somente A; internamente, o site recebe o ID da escolha real.
  function showOnlyA(rows, index, signature) {
    restoreOptions();
    const answer = rows[index];
    const first = rows[0].el;
    if (!first.parentElement) return false;

    const preview = document.createElement('div');
    preview.id = 'lb33-only-a';
    preview.setAttribute('role', 'button');
    preview.tabIndex = 0;
    preview.style.cssText = 'display:flex;gap:14px;align-items:center;padding:14px 16px;'+
      'border:1px solid #96b7a0;border-radius:10px;margin:8px 0;'+
      'background:#edf9f0;color:#1c3023;cursor:pointer;font:16px Arial,sans-serif;';
    const letter = document.createElement('strong');
    letter.textContent = 'A';
    letter.style.cssText = 'border:2px solid #188459;border-radius:50%;'+
      'width:32px;height:32px;display:grid;place-items:center;flex-shrink:0;';
    const label = document.createElement('span');
    label.textContent = answer.text.replace(/^\s*[A-H][.)\s:-]*/i, '').trim();
    preview.append(letter, label);
    const select = () => {
      choose(answer);
      state.lastClick = Date.now();
      setPhase('selected', 'Alternativa A selecionada.');
    };
    preview.addEventListener('click', select);
    preview.addEventListener('keydown', ev => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault(); select();
      }
    });
    first.parentElement.insertBefore(preview, first);

    const backups = rows.map(row => ({
      element: row.el,
      display: row.el.style.getPropertyValue('display'),
      priority: row.el.style.getPropertyPriority('display')
    }));
    for (const row of rows) row.el.style.setProperty('display', 'none', 'important');
    state.current = { preview, backups, signature, answer };
    return true;
  }

  function restoreOptions() {
    if (!state.current) return;
    for (const item of state.current.backups) {
      if (!item.element.isConnected) continue;
      if (item.display) item.element.style.setProperty('display', item.display, item.priority);
      else item.element.style.removeProperty('display');
    }
    state.current.preview.remove();
    state.current = null;
  }

  function findButton(ids, words) {
    for (const id of ids) {
      const el = document.querySelector(`[data-testid="${id}"]`);
      if (visible(el)) return el;
    }
    const allowed = new Set(words);
    return [...document.querySelectorAll('button')].find(el =>
      visible(el) && !el.closest('#lb33-panel') &&
      allowed.has(optionText(el).toLowerCase())) || null;
  }
  const checkButton = () => findButton(['exercise-check-answer'],
    ['verificar', 'verificar resposta', 'conferir', 'check answer']);
  const nextButton = () => findButton(['exercise-next-question', 'exercise-next-question-button'],
    ['próxima questão', 'próximo', 'continuar', 'next question']);

  function feedback() {
    const nodes = document.querySelectorAll('[role="alert"], [role="status"], [aria-live], .perseus-score');
    return [...nodes].filter(visible).map(optionText).join(' ');
  }
  function successFeedback(text) {
    return /resposta correta|muito bem|parab[eé]ns|correct answer|resposta certa|mandou bem|voc[eê] acertou|acertou!/i.test(text);
  }

  function analyze() {
    if (state.current) return;
    const rows = getOptions();
    if (rows.length < 2) {
      tell('Nao achei alternativas na tela. Abra uma questao de multipla escolha.');
      return;
    }
    const answer = identify(rows);
    if (!answer) {
      tell(`${rows.length} alternativas encontradas, mas sem resposta confiavel. Nao vou chutar.`);
      return;
    }
    state.source = answer.via;
    const signature = fingerprint(rows);
    if (!showOnlyA(rows, answer.index, signature)) {
      tell('Nao foi possivel reorganizar as alternativas.');
      return;
    }
    tell('Somente a resposta correta aparece como A.');
    choose(rows[answer.index]);
    state.lastClick = Date.now();
    setPhase('selected', 'A selecionada; aguardando verificacao.');
  }

  function tick() {
    if (!state.running || document.visibilityState === 'hidden') return;
    const now = Date.now();
    if (now - state.lastClick < 1200) return;

    if (state.phase === 'idle') {
      if (now - state.lastScan >= 2500) {
        state.lastScan = now;
        analyze();
      }
      return;
    }
    if (state.phase === 'selected') {
      const btn = checkButton();
      if (!btn) return;
      state.beforeFeedback = feedback();
      state.lastClick = now;
      setPhase('checking', 'Verificando o acerto...');
      btn.click();
      return;
    }
    if (state.phase === 'checking') {
      const currentFeedback = feedback();
      if (currentFeedback !== state.beforeFeedback &&
          successFeedback(currentFeedback) && nextButton()) {
        setPhase('correct', 'Acerto confirmado pela tela.');
      } else if (now - state.since > 16000) {
        state.running = false;
        updateStart();
        restoreOptions();
        setPhase('paused', 'Sem confirmacao de acerto; automacao pausada.');
      }
      return;
    }
    if (state.phase === 'correct') {
      const btn = nextButton();
      if (!btn) return;
      const oldSignature = state.current?.signature;
      restoreOptions();
      state.lastClick = now;
      setPhase('transition', 'Avancando para a proxima questao...');
      state.previousSignature = oldSignature;
      btn.click();
      return;
    }
    if (state.phase === 'transition') {
      const rows = getOptions();
      if (rows.length >= 2 && fingerprint(rows) !== state.previousSignature) {
        setPhase('idle', 'Nova questao detectada.');
      } else if (now - state.since > 20000) {
        state.running = false;
        updateStart();
        setPhase('paused', 'Nao consegui detectar a proxima questao.');
      }
    }
  }

  function updateStart() {
    const el = document.getElementById('lb33-start');
    if (el) el.textContent = state.running ? 'Pausar' : 'Iniciar';
  }

  function setupPanel() {
    if (!document.body || document.getElementById('lb33-panel')) return;
    const panel = document.createElement('section');
    panel.id = 'lb33-panel';
    panel.style.cssText = 'position:fixed;top:90px;right:16px;z-index:2147483646;'+
      'background:#123225;color:white;border-radius:12px;width:255px;'+
      'padding:14px;box-shadow:0 5px 22px #0005;font:13px Arial,sans-serif;';
    const title = document.createElement('strong');
    title.textContent = 'KHAN HELPER 3.3';
    const info = document.createElement('p');
    info.id = 'lb33-status'; info.textContent = state.message;
    const meta = document.createElement('p');
    meta.id = 'lb33-meta';
    meta.style.cssText = 'font-size:11px;opacity:.85';
    meta.textContent = 'Fonte: - | Respostas detectadas: 0';
    function button(label, action) {
      const el = document.createElement('button');
      el.textContent = label;
      el.style.cssText = 'background:#29bb78;color:#062414;border:0;border-radius:7px;'+
        'padding:9px 10px;margin:0 6px 6px 0;cursor:pointer;';
      el.addEventListener('click', action);
      return el;
    }
    const start = button('Iniciar', () => {
      state.running = !state.running;
      if (!state.running) {
        restoreOptions();
        setPhase('idle', 'Pausado.');
      } else {
        setPhase('idle', 'Automacao iniciada.');
      }
      updateStart();
    });
    start.id = 'lb33-start';
    const scan = button('Analisar', () => {
      if (state.phase === 'idle' && !state.current) analyze();
    });
    const reset = button('Restaurar', () => {
      state.running = false;
      restoreOptions();
      setPhase('idle', 'Opcoes originais restauradas.');
      updateStart();
    });
    panel.append(title, info, meta, start, scan, reset);
    document.body.appendChild(panel);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPanel, { once: true });
  } else setupPanel();
  const timer = setInterval(() => {
    try { tick(); }
    catch (e) {
      log('Erro:', e);
      state.running = false;
      restoreOptions();
      updateStart();
      setPhase('paused', 'Erro: ' + e.message);
    }
  }, 800);
  window.addEventListener('pagehide', () => {
    clearInterval(timer);
    restoreOptions();
  }, { once: true });
})();
