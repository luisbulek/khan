
 // ==UserScript==
 // @name         Khan Helper LuisBulek 3.5
 // @namespace    https://github.com/luisbulek/khan
 // @version      3.5.0
 // @description  Calcula crescimento exponencial, mostra respostas e verifica antes de avançar.
 // @match        https://*.khanacademy.org/*
 // @match        https://khanacademy.org/*
 // @run-at       document-idle
 // @grant        none
 // ==/UserScript==

(() => {
  'use strict';

  const PANEL = 'lb35-panel';
  if (document.getElementById(PANEL)) return;

  const st = {
    automatico: false,
    etapa: 'espera',
    inicio: 0,
    ultimoClique: 0,
    resultado: null,
    assinatura: '',
    feedbackAnterior: '',
    mensagem: 'Abra um exercício e clique em Analisar.'
  };

  const visivel = el => !!(
    el &&
    el.isConnected &&
    el.getClientRects().length &&
    !el.disabled &&
    el.getAttribute('aria-disabled') !== 'true'
  );

  function aviso(mensagem) {
    st.mensagem = mensagem;

    const el = document.getElementById('lb35-msg');
    if (el) el.textContent = mensagem;

    const info = document.getElementById('lb35-answer');

    if (info) {
      info.textContent = st.resultado
        ? `Resposta: ${st.resultado.letra} — ${st.resultado.texto} | Cálculo: ${st.resultado.conta}`
        : 'Resposta: ainda não identificada';
    }

    const btn = document.getElementById('lb35-run');

    if (btn) {
      btn.textContent = st.automatico
        ? 'Pausar'
        : 'Iniciar';
    }

    console.info('[Khan Helper 3.5]', mensagem);
  }

  function etapa(nome, mensagem) {
    st.etapa = nome;
    st.inicio = Date.now();

    if (mensagem) aviso(mensagem);
  }

  function texto(el) {
    return (
      el?.innerText ||
      el?.textContent ||
      ''
    ).trim();
  }

  function alternativas() {
    const grupos = document.querySelectorAll(
      '.perseus-widget-radio, ' +
      '.perseus-radio-option-list, ' +
      '[role="radiogroup"], fieldset'
    );

    for (const grupo of grupos) {
      if (!visivel(grupo)) continue;

      if (grupo.closest('#' + PANEL)) {
        continue;
      }

      for (const seletor of [
        '.perseus-radio-option',
        'li',
        'label',
        '[role="radio"]'
      ]) {
        const achados = [
          ...grupo.querySelectorAll(seletor)
        ].filter(visivel);

        const externos = achados.filter(
          el => !achados.some(
            outro => outro !== el &&
              outro.contains(el)
          )
        );

        if (
          externos.length >= 2 &&
          externos.length <= 8
        ) {
          const linhas = externos.map(el => ({
            el,
            texto: texto(el)
          }));

          if (linhas.every(l => l.texto.length)) {
            return linhas;
          }
        }
      }
    }

    // Busca alternativas com letras A, B, C, D.
    const raiz =
      document.querySelector('main') ||
      document.body;

    const porLetra = new Map();

    for (const marcador of raiz.querySelectorAll(
      'button, [role="radio"], label, [tabindex]'
    )) {
      if (!visivel(marcador)) continue;

      if (marcador.closest('#' + PANEL)) {
        continue;
      }

      const letra = (
        marcador.getAttribute('aria-label') ||
        texto(marcador)
      ).trim();

      if (!/^[A-H]$/i.test(letra)) continue;

      let linha = marcador;

      for (
        let passo = 0;
        passo < 4 && linha.parentElement;
        passo++
      ) {
        linha = linha.parentElement;

        if (texto(linha).length >= 3) {
          break;
        }
      }

      const valor = texto(linha);

      if (
        valor.length >= 3 &&
        valor.length < 180
      ) {
        porLetra.set(
          letra.toUpperCase(),
          { el: linha, texto: valor }
        );
      }
    }

    const linhas = [...porLetra]
      .sort((a, b) => a[0].localeCompare(b[0]))
      .map(([, valor]) => valor);

    return (
      linhas.length >= 2 &&
      linhas.length <= 8 &&
      new Set(linhas.map(l => l.el)).size === linhas.length
    ) ? linhas : [];
  }

  function textoQuestao() {
    const raiz =
      document.querySelector('.perseus-renderer') ||
      document.querySelector('main') ||
      document.body;

    return texto(raiz).slice(0, 16000);
  }

  function fontesFormula() {
    const raiz =
      document.querySelector('.perseus-renderer') ||
      document.querySelector('main') ||
      document.body;

    const fontes = [texto(raiz)];

    for (const el of raiz.querySelectorAll(
      'annotation[encoding="application/x-tex"], ' +
      'script[type^="math/tex"], ' +
      '[data-tex], math[alttext], img[alt]'
    )) {
      const s =
        el.getAttribute('data-tex') ||
        el.getAttribute('alttext') ||
        el.getAttribute('alt') ||
        el.textContent;

      if (s) fontes.push(s);
    }

    // Também tenta ler expressões em MathML.
    for (const math of raiz.querySelectorAll('math')) {
      let s = '';

      for (const node of math.querySelectorAll(
        'mi, mn, mo, mtext'
      )) {
        s += node.textContent;
      }

      if (s) fontes.push(s);
    }

    return [...new Set(fontes)];
  }

  function interpretarModelo(source) {
    const s = source
      .replace(/\\left|\\right|\\,/g, '')
      .replace(/\\times|\\cdot/g, '×')
      .replace(/\{,\}/g, ',')
      .replace(/[−–]/g, '-')
      .replace(/\s+/g, '');

    // Exemplo: C(t)=120×(1,08)^t
    const m = s.match(
      /[A-Za-z]\(t\)=(\d+(?:[.,]\d+)?)[×*x]\(?(\d+[.,]\d+)\)?(?:\^\{?t\}?|t)/i
    );

    if (!m) return null;

    const inicial = Number(
      m[1].replace(',', '.')
    );

    const fator = Number(
      m[2].replace(',', '.')
    );

    if (inicial <= 0 || fator <= 0) {
      return null;
    }

    return { inicial, fator };
  }

  function obterTempo(enunciado) {
    const regras = [
      /(?:no|para\s+o|ao)\s*(\d+)\s*[º°oª]?\s*dia\b/i,
      /(?:ap[oó]s|em)\s*(\d+)\s*dias\b/i,
      /\bt\s*=\s*(\d+)\b/i
    ];

    for (const re of regras) {
      const match = enunciado.match(re);

      if (match) {
        return Number(match[1]);
      }
    }

    return null;
  }

  function numeroAlternativa(raw) {
    const s = raw
      .replace(/^\s*[A-H][.):]?\s+/i, '')
      .trim();

    const match = s.match(
      /[-+]?\d+(?:[.,]\d+)?\s*$/
    );

    if (!match) return null;

    const numero = Number(
      match[0].replace(',', '.')
    );

    return Number.isFinite(numero)
      ? numero
      : null;
  }

  function identificar() {
    const linhas = alternativas();

    if (linhas.length < 2) {
      return {
        erro: 'Não encontrei as alternativas na página.'
      };
    }

    const enunciado = textoQuestao();
    const tempo = obterTempo(enunciado);

    if (tempo === null) {
      return {
        erro: 'Encontrei as alternativas, mas não identifiquei o dia solicitado.'
      };
    }

    let modelo = null;

    for (const fonte of fontesFormula()) {
      modelo = interpretarModelo(fonte);

      if (modelo) break;
    }

    if (!modelo) {
      return {
        erro: 'Encontrei as alternativas, mas não consegui ler a fórmula C(t).'
      };
    }

    const calculado =
      modelo.inicial *
      Math.pow(modelo.fator, tempo);

    const lista = linhas
      .map((linha, indice) => ({
        indice,
        valor: numeroAlternativa(linha.texto),
        linha
      }))
      .filter(a => a.valor !== null);

    if (lista.length !== linhas.length) {
      return {
        erro: 'Não consegui ler os valores das alternativas.'
      };
    }

    lista.sort(
      (a, b) =>
        Math.abs(a.valor - calculado) -
        Math.abs(b.valor - calculado)
    );

    const tolerancia = Math.max(
      0.15,
      Math.abs(calculado) * 0.005
    );

    if (
      lista.length < 2 ||
      Math.abs(lista[0].valor - calculado) > tolerancia ||
      Math.abs(lista[1].valor - calculado) -
      Math.abs(lista[0].valor - calculado) < 0.1
    ) {
      return {
        erro: 'Nenhuma alternativa corresponde de forma confiável ao cálculo.'
      };
    }

    const melhor = lista[0];

    return {
      indice: melhor.indice,

      letra: String.fromCharCode(
        65 + melhor.indice
      ),

      texto: melhor.linha.texto
        .replace(/^\s*[A-H][.):]?\s+/i, '')
        .trim(),

      linha: melhor.linha,

      conta:
        `${modelo.inicial} × ${modelo.fator}^${tempo} ≈ ` +
        calculado.toFixed(2).replace('.', ',')
    };
  }

  function selecionar(linha) {
    const el = linha.el;

    const candidatos = [
      el.querySelector('[role="radio"]'),
      el.querySelector('label'),
      el.querySelector('button'),
      el.querySelector('input[type="radio"]'),
      el
    ];

    const alvo = candidatos.find(visivel);

    if (!alvo) return false;

    alvo.click();
    return true;
  }

  function procurarBotao(ids, rotulos) {
    for (const id of ids) {
      const botao = document.querySelector(
        `[data-testid="${id}"]`
      );

      if (visivel(botao)) return botao;
    }

    return [
      ...document.querySelectorAll('button')
    ].find(el =>
      visivel(el) &&
      !el.closest('#' + PANEL) &&
      rotulos.some(
        s => texto(el).toLowerCase() === s
      )
    ) || null;
  }

  const botaoVerificar = () => procurarBotao(
    ['exercise-check-answer'],
    [
      'verificar',
      'verificar resposta',
      'conferir',
      'check answer'
    ]
  );

  const botaoProximo = () => procurarBotao(
    [
      'exercise-next-question',
      'exercise-next-question-button'
    ],
    [
      'próxima questão',
      'próximo',
      'continuar',
      'next question'
    ]
  );

  function textoFeedback() {
    return [
      ...document.querySelectorAll(
        '[role="alert"], [role="status"], [aria-live]'
      )
    ]
      .filter(visivel)
      .map(texto)
      .join(' ');
  }

  function assinatura() {
    return textoQuestao().slice(0, 1000) +
      '||' +
      alternativas()
        .map(l => l.texto)
        .join('|');
  }

  function analisar() {
    const achado = identificar();

    if (achado.erro) {
      st.resultado = null;
      aviso(achado.erro);
      return false;
    }

    st.resultado = achado;
    st.assinatura = assinatura();

    etapa(
      'encontrada',
      'Resposta encontrada. Clique em Iniciar para selecionar e verificar.'
    );

    return true;
  }

  function pausar(mensagem) {
    st.automatico = false;
    etapa('pausada', mensagem);
  }

  function passo() {
    if (
      !st.automatico ||
      document.visibilityState === 'hidden'
    ) {
      return;
    }

    const agora = Date.now();

    if (agora - st.ultimoClique < 1300) {
      return;
    }

    if (
      st.etapa === 'espera' ||
      st.etapa === 'pausada'
    ) {
      if (!analisar()) {
        return pausar(st.mensagem);
      }
    }

    if (st.etapa === 'encontrada') {
      if (!selecionar(st.resultado.linha)) {
        return pausar(
          'Não consegui clicar na alternativa correta.'
        );
      }

      st.ultimoClique = agora;

      etapa(
        'selecionada',
        `Selecionei ${st.resultado.letra} — ${st.resultado.texto}.`
      );

      return;
    }

    if (st.etapa === 'selecionada') {
      const btn = botaoVerificar();

      if (!btn) {
        if (agora - st.inicio > 9000) {
          pausar(
            'Resposta selecionada, mas não encontrei o botão Verificar.'
          );
        }

        return;
      }

      st.feedbackAnterior = textoFeedback();
      st.ultimoClique = agora;

      etapa(
        'verificando',
        'Resposta enviada; aguardando confirmação do site.'
      );

      btn.click();
      return;
    }

    if (st.etapa === 'verificando') {
      const atual = textoFeedback();

      const correto =
        atual !== st.feedbackAnterior &&
        /(?:resposta correta|correto!|muito bem|parab[eé]ns|mandou bem|voc[eê] acertou|correct answer)/i.test(atual);

      if (correto) {
        etapa(
          'correta',
          'Acerto confirmado na interface.'
        );
      } else if (agora - st.inicio > 15000) {
        pausar(
          'Resposta enviada, mas não consegui confirmar o acerto. Não vou pular.'
        );
      }

      return;
    }

    if (st.etapa === 'correta') {
      const btn = botaoProximo();

      if (!btn) return;

      st.ultimoClique = agora;

      etapa(
        'mudando',
        'Acerto confirmado. Indo à próxima questão.'
      );

      btn.click();
      return;
    }

    if (st.etapa === 'mudando') {
      if (assinatura() !== st.assinatura) {
        st.resultado = null;

        etapa(
          'espera',
          'Próxima questão carregada.'
        );
      } else if (agora - st.inicio > 20000) {
        pausar(
          'Não consegui detectar a próxima questão.'
        );
      }
    }
  }

  function painel() {
    if (
      !document.body ||
      document.getElementById(PANEL)
    ) {
      return;
    }

    const p = document.createElement('section');
    p.id = PANEL;

    p.style.cssText =
      'position:fixed;right:14px;top:72px;' +
      'z-index:2147483646;background:#123326;' +
      'color:white;padding:14px;border-radius:12px;' +
      'width:290px;box-shadow:0 5px 22px #0006;' +
      'font:13px Arial,sans-serif;';

    const titulo = document.createElement('strong');
    titulo.textContent = 'KHAN HELPER 3.5';

    const resposta = document.createElement('p');
    resposta.id = 'lb35-answer';

    resposta.style.cssText =
      'font-weight:bold;color:#9afab9;' +
      'line-height:1.5;';

    const msg = document.createElement('p');
    msg.id = 'lb35-msg';
    msg.style.lineHeight = '1.5';

    function botao(rotulo, acao) {
      const b = document.createElement('button');

      b.textContent = rotulo;

      b.style.cssText =
        'border:0;border-radius:7px;' +
        'background:#25be78;color:#052516;' +
        'padding:9px 11px;margin:0 7px 6px 0;' +
        'cursor:pointer;';

      b.addEventListener('click', acao);
      return b;
    }

    const analisarBtn = botao(
      'Analisar',
      analisar
    );

    const iniciarBtn = botao(
      'Iniciar',
      () => {
        st.automatico = !st.automatico;

        if (
          st.automatico &&
          ['pausada', 'espera'].includes(st.etapa)
        ) {
          etapa('espera');
        }

        aviso(
          st.automatico
            ? 'Automação iniciada.'
            : 'Automação pausada.'
        );
      }
    );

    iniciarBtn.id = 'lb35-run';

    const pararBtn = botao(
      'Parar',
      () => pausar('Automação interrompida.')
    );

    p.append(
      titulo,
      resposta,
      msg,
      analisarBtn,
      iniciarBtn,
      pararBtn
    );

    document.body.appendChild(p);
    aviso(st.mensagem);
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      painel,
      { once: true }
    );
  } else {
    painel();
  }

  setInterval(() => {
    try {
      passo();
    } catch (e) {
      console.error('[Khan Helper 3.5]', e);
      pausar('Erro: ' + e.message);
    }
  }, 900);
})();
