
 // ==UserScript==
 // @name         Khan Stable - LuisBulek 2.9.0
 // @namespace    https://github.com/luisbulek/khan
 // @version      2.9.0
 // @description  Reordena alternativas identificadas e avanca somente apos acerto confirmado
 // @match        https://*.khanacademy.org/*
 // @match        https://khanacademy.org/*
 // @run-at       document-start
 // @grant        none
 // ==/UserScript==

(() => {
  'use strict';
  if (window.__LB_KHAN_290__) return;
  window.__LB_KHAN_290__ = true;

  const ID = 'lb-khan-290';
  const state = {
    active: true,
    phase: 'idle',
    itemId: null,
    since: Date.now(),
    message: 'Aguardando uma nova questao...'
  };
  let statusNode = null;
  let toggleNode = null;
  let lastAction = 0;
  const originalFetch = window.fetch;

  function report(message) {
    state.message = message;
    console.info('[Khan Stable]', message);
    if (statusNode) statusNode.textContent = message;
    if (toggleNode) toggleNode.textContent =
      state.active ? 'Pausar' : 'Iniciar';
  }

  function visible(el) {
    return Boolean(el && el.isConnected && !el.disabled &&
      el.getAttribute('aria-disabled') !== 'true' &&
      el.getClientRects().length);
  }

  function buttonByTestId(ids) {
    for (const id of ids) {
      const btn = document.querySelector(
        `[data-testid="${id}"]`
      );
      if (visible(btn)) return btn;
    }
    return null;
  }

  function buttonByText(values) {
    const allowed = new Set(values);
    return [...document.querySelectorAll('button')].find(el =>
      visible(el) &&
      allowed.has((el.textContent || '').trim().toLowerCase())
    ) || null;
  }

  function checkButton() {
    return buttonByTestId(['exercise-check-answer']) ||
      buttonByText([
        'verificar',
        'verificar resposta',
        'check answer'
      ]);
  }

  function nextButton() {
    return buttonByTestId([
      'exercise-next-question',
      'exercise-next-question-button'
    ]) || buttonByText([
      'próxima questão',
      'proxima questao',
      'próxima pergunta',
      'proxima pergunta',
      'next question'
    ]);
  }

  function findQuestionItem(payload) {
    if (!payload || !payload.data) return null;
    for (const section of Object.values(payload.data)) {
      if (section && section.item &&
          typeof section.item.itemData === 'string') {
        return section.item;
      }
    }
    return null;
  }

  function prepareAssessment(payload) {
    const item = findQuestionItem(payload);
    if (!item) return false;

    let data;
    try {
      data = JSON.parse(item.itemData);
    } catch {
      return false;
    }

    const question = data && data.question;
    if (!question ||
        typeof question.content !== 'string' ||
        !question.widgets) {
      return false;
    }

    const used = Object.entries(question.widgets)
      .filter(([key]) =>
        question.content.includes('☃ ' + key)
      );

    if (used.length !== 1 ||
        used[0][1].type !== 'radio') {
      state.phase = 'unsupported';
      report('Questao nao compativel: nenhum clique automatico.');
      return false;
    }

    const widget = used[0][1];
    const choices = widget.options && widget.options.choices;

    if (!Array.isArray(choices) ||
        choices.length < 2 ||
        widget.options.multipleSelect ||
        choices.filter(c => c.correct === true).length !== 1) {
      state.phase = 'unsupported';
      report('Resposta correta nao disponivel; automacao parada nesta questao.');
      return false;
    }

    const correctIndex = choices.findIndex(
      choice => choice.correct === true
    );

    const reordered = [
      choices[correctIndex],
      ...choices.filter((_, index) => index !== correctIndex)
    ];

    widget.options.choices = reordered;
    widget.options.randomize = false;
    item.itemData = JSON.stringify(data);

    state.itemId = String(
      item.id || 'questao-' + Date.now()
    );
    state.phase = 'ready';
    state.since = Date.now();

    report('Alternativa correta colocada em A. Aguardando renderizacao.');
    return true;
  }

  function parseAttempt(payload) {
    const verdict =
      payload?.data?.attemptProblem?.result
        ?.actionResults?.attemptCorrect;

    if (verdict === true &&
        state.phase === 'submitting') {
      state.phase = 'correct';
      state.since = Date.now();
      report('Acerto confirmado pelo Khan Academy.');
    } else if (verdict === false &&
               state.phase === 'submitting') {
      state.phase = 'unsupported';
      state.active = false;
      report('O site rejeitou a resposta. Pausado para evitar erros.');
    }
  }

  // Mantem a validacao original da plataforma.
  window.fetch = async function (...args) {
    const response = await originalFetch.apply(this, args);

    try {
      const url = args[0] instanceof Request
        ? args[0].url
        : String(args[0]);

      if (!url.includes('getAssessmentItem') &&
          !url.includes('attemptProblem')) {
        return response;
      }

      const payload = await response.clone().json();

      if (url.includes('attemptProblem')) {
        parseAttempt(payload);
        return response;
      }

      if (!prepareAssessment(payload)) {
        return response;
      }

      const headers = new Headers(response.headers);
      headers.delete('content-length');
      headers.delete('content-encoding');

      return new Response(JSON.stringify(payload), {
        status: response.status,
        statusText: response.statusText,
        headers
      });
    } catch (error) {
      console.warn(
        '[Khan Stable] Resposta nao interpretada:',
        error
      );
      return response;
    }
  };

  function findFirstChoice() {
    const containers = document.querySelectorAll(
      '.perseus-widget-radio, .perseus-widget-container'
    );

    for (const container of containers) {
      const first = container.querySelector('li');
      if (!first) continue;

      const option = first.querySelector(
        'button, input[type="radio"], label, [role="radio"]'
      );

      if (visible(option)) return option;
    }
    return null;
  }

  function tick() {
    if (!state.active ||
        document.visibilityState === 'hidden') return;

    const now = Date.now();
    if (now - lastAction < 900) return;

    if (state.phase === 'ready') {
      const first = findFirstChoice();
      if (!first) return;

      lastAction = now;
      first.click();

      state.phase = 'selected';
      state.since = now;
      report('Alternativa A selecionada.');

    } else if (state.phase === 'selected' &&
               now - state.since > 500) {
      const check = checkButton();
      if (!check) return;

      lastAction = now;
      state.phase = 'submitting';
      state.since = now;
      check.click();

      report('Enviando resposta e aguardando confirmacao...');

    } else if (state.phase === 'correct' &&
               now - state.since > 500) {
      const next = nextButton();
      if (!next) return;

      lastAction = now;
      state.phase = 'next';
      next.click();

      report('Acerto confirmado. Avancando para a proxima questao...');

    } else if (state.phase === 'submitting' &&
               now - state.since > 15000) {
      state.active = false;
      state.phase = 'unsupported';

      report('Nao chegou confirmacao do acerto. Automacao pausada.');
    }
  }

  function makePanel() {
    if (!document.body ||
        document.getElementById(ID)) return;

    const panel = document.createElement('div');
    panel.id = ID;

    Object.assign(panel.style, {
      position: 'fixed',
      right: '16px',
      bottom: '16px',
      zIndex: '2147483646',
      background: '#142b20',
      color: 'white',
      padding: '12px 14px',
      borderRadius: '12px',
      width: '245px',
      boxShadow: '0 4px 16px #0006',
      font: '13px Arial, sans-serif'
    });

    const header = document.createElement('strong');
    header.textContent = 'KB 2.9.0';

    const status = document.createElement('p');
    status.style.margin = '10px 0';
    status.textContent = state.message;
    statusNode = status;

    const toggle = document.createElement('button');
    toggle.textContent = state.active ? 'Pausar' : 'Iniciar';
    toggleNode = toggle;

    Object.assign(toggle.style, {
      background: '#32a96b',
      color: '#102016',
      border: 'none',
      borderRadius: '6px',
      padding: '8px 12px',
      cursor: 'pointer'
    });

    toggle.addEventListener('click', () => {
      state.active = !state.active;
      report(
        state.active
          ? 'Automacao ativada.'
          : 'Automacao pausada.'
      );
    });

    panel.append(header, status, toggle);
    document.body.appendChild(panel);
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      makePanel,
      { once: true }
    );
  } else {
    makePanel();
  }

  setInterval(tick, 700);
})();
