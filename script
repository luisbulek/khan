
 // ==UserScript==
 // @name         Khan Stable - LuisBulek
 // @namespace    https://github.com/luisbulek/khan
 // @version      2.8.3
 // @description  Painel leve de controles para Khan Academy
 // @match        https://*.khanacademy.org/*
 // @match        https://khanacademy.org/*
 // @grant        none
 // @run-at       document-idle
 // ==/UserScript==

(function () {
    "use strict";

    const APP_ID = "luisbulek-khan-stable";
    const BUTTON_ID = APP_ID + "-button";
    const PANEL_ID = APP_ID + "-panel";
    const DARK_STYLE_ID = APP_ID + "-dark";
    const MIN_CLICK_INTERVAL = 2500;
    const AUTO_INTERVAL = 3500;

    // Evita criar vários painéis ou temporizadores.
    if (document.getElementById(BUTTON_ID)) {
        console.info("[Khan Stable] Já está aberto.");
        return;
    }

    let autoTimer = null;
    let lastClick = 0;
    let notificationTimer = null;

    function notify(message) {
        let toast = document.getElementById(APP_ID + "-toast");

        if (!toast) {
            toast = document.createElement("div");
            toast.id = APP_ID + "-toast";

            Object.assign(toast.style, {
                position: "fixed",
                left: "50%",
                bottom: "86px",
                transform: "translateX(-50%)",
                padding: "10px 16px",
                borderRadius: "9px",
                background: "#163d2b",
                color: "#fff",
                font: "13px Arial, sans-serif",
                boxShadow: "0 4px 18px #0005",
                zIndex: "2147483647",
                maxWidth: "80vw",
                textAlign: "center"
            });

            document.body.appendChild(toast);
        }

        toast.textContent = message;
        toast.style.display = "block";
        clearTimeout(notificationTimer);

        notificationTimer = setTimeout(() => {
            if (toast.isConnected) {
                toast.style.display = "none";
            }
        }, 2400);
    }

    function isClickable(element) {
        return Boolean(
            element &&
            element.isConnected &&
            !element.disabled &&
            element.getAttribute("aria-disabled") !== "true" &&
            element.getClientRects().length > 0
        );
    }

    function findNextButton() {
        const selectors = [
            '[data-testid="exercise-next-question"]',
            '[data-testid="exercise-next-question-button"]'
        ];

        for (const selector of selectors) {
            const element = document.querySelector(selector);

            if (isClickable(element)) {
                return element;
            }
        }

        const labels = new Set([
            "próxima questão",
            "proxima questao",
            "próxima pergunta",
            "proxima pergunta"
        ]);

        for (const button of document.querySelectorAll("button")) {
            const text = (button.textContent || "")
                .trim()
                .toLowerCase();

            if (labels.has(text) && isClickable(button)) {
                return button;
            }
        }

        return null;
    }

    function advanceOnce(showMessage = true) {
        const button = findNextButton();

        if (!button) {
            if (showMessage) {
                notify("Nenhum botão de próxima questão disponível.");
            }
            return false;
        }

        const now = Date.now();

        if (now - lastClick < MIN_CLICK_INTERVAL) {
            return false;
        }

        lastClick = now;
        button.click();

        if (showMessage) {
            notify("Avançou para a próxima questão.");
        }

        return true;
    }

    function stopAuto() {
        if (autoTimer !== null) {
            clearInterval(autoTimer);
            autoTimer = null;
        }

        updateAutoLabel();
    }

    function toggleAuto() {
        if (autoTimer !== null) {
            stopAuto();
            notify("Auto-avançar desligado.");
            return;
        }

        autoTimer = setInterval(() => {
            if (document.visibilityState !== "visible") {
                return;
            }

            try {
                advanceOnce(false);
            } catch (error) {
                console.error(
                    "[Khan Stable] Erro no auto-avançar:",
                    error
                );

                stopAuto();
                notify("Auto-avançar pausado por erro.");
            }
        }, AUTO_INTERVAL);

        updateAutoLabel();
        notify("Auto-avançar ligado.");
    }

    function toggleDark() {
        const existing = document.getElementById(DARK_STYLE_ID);

        if (existing) {
            existing.remove();
            notify("Modo escuro desligado.");
            return;
        }

        const style = document.createElement("style");
        style.id = DARK_STYLE_ID;

        style.textContent = `
            html {
                filter: invert(1) hue-rotate(180deg);
                background: #111;
            }

            img, video, canvas, svg {
                filter: invert(1) hue-rotate(180deg);
            }

            #${BUTTON_ID},
            #${PANEL_ID},
            #${APP_ID}-toast {
                filter: invert(1) hue-rotate(180deg);
            }
        `;

        document.head.appendChild(style);
        notify("Modo escuro ligado.");
    }

    let autoButton;

    function updateAutoLabel() {
        if (autoButton) {
            autoButton.textContent = autoTimer === null
                ? "Auto-avançar: DESLIGADO"
                : "Auto-avançar: LIGADO";
        }
    }

    function createAction(label, action) {
        const button = document.createElement("button");

        button.type = "button";
        button.textContent = label;

        Object.assign(button.style, {
            display: "block",
            width: "100%",
            margin: "0 0 9px",
            padding: "11px",
            background: "#28533c",
            color: "white",
            border: "1px solid #357e59",
            borderRadius: "8px",
            textAlign: "left",
            cursor: "pointer",
            font: "13px Arial, sans-serif"
        });

        button.addEventListener("click", action);

        return button;
    }

    function start() {
        if (!document.body) return;
        if (document.getElementById(BUTTON_ID)) return;

        const opener = document.createElement("button");

        opener.id = BUTTON_ID;
        opener.type = "button";
        opener.textContent = "KB";

        opener.setAttribute(
            "aria-label",
            "Abrir controles do Khan Stable"
        );

        Object.assign(opener.style, {
            position: "fixed",
            right: "20px",
            bottom: "20px",
            width: "52px",
            height: "52px",
            borderRadius: "50%",
            background: "#13a66b",
            color: "white",
            border: "none",
            font: "bold 16px Arial, sans-serif",
            cursor: "pointer",
            zIndex: "2147483646",
            boxShadow: "0 4px 18px #0005"
        });

        const panel = document.createElement("div");
        panel.id = PANEL_ID;

        Object.assign(panel.style, {
            position: "fixed",
            right: "20px",
            bottom: "84px",
            width: "250px",
            boxSizing: "border-box",
            padding: "16px",
            borderRadius: "14px",
            background: "#17241d",
            color: "white",
            display: "none",
            zIndex: "2147483646",
            font: "13px Arial, sans-serif",
            boxShadow: "0 4px 20px #0006"
        });

        const heading = document.createElement("strong");

        heading.textContent = "KHAN STABLE 2.8.3";
        heading.style.display = "block";
        heading.style.marginBottom = "15px";

        panel.appendChild(heading);

        autoButton = createAction(
            "Auto-avançar: DESLIGADO",
            toggleAuto
        );

        panel.appendChild(autoButton);

        panel.appendChild(
            createAction("Avançar uma vez", () => {
                advanceOnce(true);
            })
        );

        panel.appendChild(
            createAction("Alternar modo escuro", toggleDark)
        );

        panel.appendChild(
            createAction("Parar automação", () => {
                stopAuto();
                notify("Automação interrompida.");
            })
        );

        const footnote = document.createElement("small");

        footnote.textContent =
            "Avança apenas quando o botão de próxima questão " +
            "está disponível. Não altera respostas ou notas.";

        footnote.style.color = "#b7cfc0";
        panel.appendChild(footnote);

        opener.addEventListener("click", () => {
            const open = panel.style.display === "none";

            panel.style.display = open ? "block" : "none";

            opener.setAttribute(
                "aria-expanded",
                String(open)
            );
        });

        document.body.appendChild(panel);
        document.body.appendChild(opener);

        window.addEventListener(
            "pagehide",
            stopAuto,
            { once: true }
        );

        console.info(
            "[Khan Stable] Iniciado com sucesso."
        );

        notify("Khan Stable 2.8.3 carregado!");
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            start,
            { once: true }
        );
    } else {
        start();
    }
})();
