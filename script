
 // ==UserScript==
 // @name         Khan Helper LuisBulek 3.6
 // @namespace    https://github.com/luisbulek/khan
 // @version      3.6.0
 // @description  Analisa alternativas numericas em equacoes exponenciais e modelos de crescimento.
 // @match        https://*.khanacademy.org/*
 // @match        https://khanacademy.org/*
 // @run-at       document-start
 // @grant        none
 // ==/UserScript==

(() => {
  'use strict';
  if (window.__LB_KHAN_36__) return;
  window.__LB_KHAN_36__ = true;

  const S = {
    ativo: false, etapa: 'parado', desde: Date.now(), ultimo: 0,
    resposta: null, assinatura: '', anterior: '',
    mensagem: 'Abra uma questao e clique em Analisar.',
    gabaritos: [], visual: null
  };
  const normal = s => String(s ?? '').replace(/\u00a0/g, ' ').replace(/,/g, '.')
    .replace(/\*\*/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
  const texto = el => (el?.innerText || el?.textContent || '').trim();
  const visivel = el => !!(el && el.isConnected && el.getClientRects().length &&
    !el.disabled && el.getAttribute('aria-disabled') !== 'true');

  function aviso(msg) {
    S.mensagem = msg;
    console.info('[Khan Helper 3.6]', msg);
    const e = document.getElementById('lb36-msg');
    if (e) e.textContent = msg;
    const r = document.getElementById('lb36-resp');
    if (r) r.textContent = S.resposta
      ? `Resposta: ${S.resposta.letra} (${S.resposta.valor}) — ${S.resposta.metodo}`
      : 'Resposta ainda nao encontrada';
    const b = document.getElementById('lb36-start');
    if (b) b.textContent = S.ativo ? 'Pausar' : 'Iniciar';
  }
  function fase(etapa, msg) {
    S.etapa = etapa;
    S.desde = Date.now();
    if (msg) aviso(msg);
  }

  // As respostas capturadas sao somente lidas, nunca enviadas como gabarito falso.
  function inspecionar(data) {
    const vistos = new WeakSet();
    function andar(obj, nivel = 0) {
      if (!obj || typeof obj !== 'object' || nivel > 10 || vistos.has(obj)) return;
      vistos.add(obj);
      if (typeof obj.itemData === 'string') {
        try {
          const q = JSON.parse(obj.itemData).question;
          for (const [key, w] of Object.entries(q?.widgets || {})) {
            if (w?.type !== 'radio' || w.options?.multipleSelect) continue;
            if (q.content && !q.content.includes('☃ ' + key)) continue;
            const choices = w.options?.choices;
            if (!Array.isArray(choices)) continue;
            const certas = choices.filter(c => c.correct === true);
            if (certas.length !== 1) continue;
            S.gabaritos.push({
              alternativas: choices.map(c => normal(c.content)),
              correta: normal(certas[0].content)
            });
          }
          S.gabaritos = S.gabaritos.slice(-20);
        } catch (e) { console.debug('[Khan Helper 3.6]', e); }
      }
      for (const v of Object.values(obj)) andar(v, nivel + 1);
    }
    andar(data);
  }
  const fetchOriginal = window.fetch;
  if (typeof fetchOriginal === 'function') {
    window.fetch = async function(...args) {
      const resposta = await fetchOriginal.apply(this, args);
      try {
        const url = args[0] instanceof Request ? args[0].url : String(args[0]);
        if (resposta.ok && /graphql|assessment/i.test(url) &&
            /json/i.test(resposta.headers.get('content-type') || '')) {
          resposta.clone().json().then(inspecionar).catch(() => {});
        }
      } catch (e) { console.debug('[Khan Helper 3.6]', e); }
      return resposta;
    };
  }

  function alternativas() {
    const grupos = document.querySelectorAll(
      '.perseus-widget-radio, .perseus-radio-option-list, [role="radiogroup"], fieldset'
    );
    for (const grupo of grupos) {
      if (!visivel(grupo) || grupo.closest('#lb36-panel')) continue;
      for (const seletor of ['.perseus-radio-option', 'li', 'label', '[role="radio"]']) {
        const achados = [...grupo.querySelectorAll(seletor)].filter(visivel);
        const linhas = achados.filter(e => !achados.some(outro => outro !== e && outro.contains(e)));
        if (linhas.length >= 2 && linhas.length <= 8 && linhas.every(e => texto(e))) {
          return linhas.map(el => ({ el, nome: texto(el) }));
        }
      }
    }
    // Interface com circulos A, B, C, D.
    const mapa = new Map();
    const raiz = document.querySelector('main') || document.body;
    if (!raiz) return [];
    for (const el of raiz.querySelectorAll('button, [role="radio"], label, [tabindex]')) {
      if (!visivel(el) || el.closest('#lb36-panel')) continue;
      const letra = (el.getAttribute('aria-label') || texto(el)).trim();
      if (!/^[A-H]$/i.test(letra)) continue;
      let linha = el;
      for (let n = 0; n < 4 && linha.parentElement; n++) {
        linha = linha.parentElement;
        if (texto(linha).length >= 3) break;
      }
      if (texto(linha).length >= 3 && texto(linha).length < 200) {
        mapa.set(letra.toUpperCase(), { el: linha, nome: texto(linha) });
      }
    }
    const linhas = [...mapa].sort((a,b) => a[0].localeCompare(b[0])).map(x => x[1]);
    return linhas.length >= 2 && linhas.length <= 8 &&
      new Set(linhas.map(x => x.el)).size === linhas.length ? linhas : [];
  }

  function numero(txt) {
    const s = txt.trim().replace(/^\s*[A-H]\s*[.):]?\s+/i, '').replace(',', '.').trim();
    if (/^[+-]?\d+(?:\.\d+)?$/.test(s)) return Number(s);
    const f = s.match(/^([+-]?\d+)\s*\/\s*(\d+)$/);
    return f && Number(f[2]) ? Number(f[1]) / Number(f[2]) : null;
  }

  function mathML(el) {
    const tag = el.localName?.toLowerCase();
    const filhos = [...el.children].filter(c => c.localName !== 'annotation');
    const ler = c => mathML(c);
    if (['mi','mn','mo','mtext'].includes(tag)) return el.textContent || '';
    if (tag === 'mfrac' && filhos.length === 2)
      return `\\frac{${ler(filhos[0])}}{${ler(filhos[1])}}`;
    if (tag === 'msup' && filhos.length === 2)
      return `(${ler(filhos[0])})^{${ler(filhos[1])}}`;
    if (tag === 'semantics') return filhos.length ? ler(filhos[0]) : '';
    return filhos.map(ler).join('');
  }

  function formulas() {
    const raiz = document.querySelector('.perseus-renderer') ||
      document.querySelector('main') || document.body;
    if (!raiz) return [];
    const fontes = [];
    for (const el of raiz.querySelectorAll(
      'annotation[encoding*="tex"], script[type^="math/tex"], [data-tex], img[alt], math[alttext]'
    )) {
      const valor = el.getAttribute('data-tex') || el.getAttribute('alttext') ||
        el.getAttribute('alt') || el.textContent;
      if (valor) fontes.push(valor);
    }
    for (const el of raiz.querySelectorAll('math')) {
      const valor = mathML(el);
      if (valor) fontes.push(valor);
    }
    // Alguns enunciados apresentam o calculo como texto.
    fontes.push(texto(raiz));
    return [...new Set(fontes)];
  }

  // Interpretador de expressoes: fracoes, potencias, +, -, *, / e x.
  // Nunca utiliza eval() para calcular texto vindo da pagina.
  function testarEquacao(expressao, x) {
    const src = String(expressao)
      .replace(/\\left|\\right/g, '')
      .replace(/\\(?:dfrac|tfrac)/g, '\\frac')
      .replace(/\\(?:cdot|times)/g, '*')
      .replace(/[×⋅]/g, '*').replace(/[÷]/g, '/')
      .replace(/[−–]/g, '-').replace(/\\[,;! ]/g, '')
      .replace(/\s+/g, '').replace(/,/g, '.');
    if (!src.includes('=') || !/[xX]/.test(src)) return null;
    const tokens = [];
    const rx = /\\frac|\d+(?:\.\d+)?|[xX]|[+\-*/^=(){}]/gy;
    let pos = 0;
    while (pos < src.length) {
      rx.lastIndex = pos;
      const match = rx.exec(src);
      if (!match) return null;
      tokens.push(match[0]);
      pos = rx.lastIndex;
    }
    let i = 0;
    const atual = () => tokens[i];
    const exigir = t => { if (tokens[i++] !== t) throw Error('Expressao inesperada'); };
    function grupo() {
      const abre = atual();
      if (abre !== '{' && abre !== '(') throw Error('Grupo invalido');
      i++;
      const v = soma();
      exigir(abre === '{' ? '}' : ')');
      return v;
    }
    function atom() {
      const t = atual();
      if (t === '\\frac') { i++; return grupo() / grupo(); }
      if (t === '(' || t === '{') return grupo();
      if (t === 'x' || t === 'X') { i++; return x; }
      if (/^\d/.test(t || '')) { i++; return Number(t); }
      throw Error('Numero esperado');
    }
    function potencia() {
      const base = atom();
      if (atual() !== '^') return base;
      i++;
      const expoente = atual() === '{' || atual() === '(' ? grupo() : unario();
      return Math.pow(base, expoente);
    }
    function unario() {
      if (atual() === '+') { i++; return unario(); }
      if (atual() === '-') { i++; return -unario(); }
      return potencia();
    }
    function produto() {
      let v = unario();
      for (;;) {
        if (atual() === '*' || atual() === '/') {
          const op = tokens[i++], outro = unario();
          v = op === '*' ? v * outro : v / outro;
        } else if (/^(?:x|X|\d)/.test(atual() || '') ||
                   atual() === '(' || atual() === '{' || atual() === '\\frac') {
          v *= unario();
        } else break;
      }
      return v;
    }
    function soma() {
      let v = produto();
      while (atual() === '+' || atual() === '-') {
        const op = tokens[i++], outro = produto();
        v += op === '+' ? outro : -outro;
      }
      return v;
    }
    try {
      const a = soma();
      exigir('=');
      const b = soma();
      if (i !== tokens.length || !Number.isFinite(a) || !Number.isFinite(b)) return null;
      return Math.abs(a - b) <= Math.max(1, Math.abs(a), Math.abs(b)) * 1e-8;
    } catch { return null; }
  }

  function resolverCrescimento(linhas) {
    const enunciado = formulas().join(' ');
    const tempo = enunciado.match(/(?:no|para\s+o|ao)\s*(\d+)\s*[º°oª]?\s*dia\b|(?:ap[oó]s|em)\s*(\d+)\s*dias\b/i);
    if (!tempo) return null;
    const dias = Number(tempo[1] || tempo[2]);
    for (const fonte of formulas()) {
      const src = fonte.replace(/\\left|\\right/g, '')
        .replace(/\\(?:cdot|times)/g, '*').replace(/[×⋅]/g, '*')
        .replace(/\s+/g, '').replace(/\{,\}/g, ',');
      const m = src.match(/[A-Za-z]\(t\)=(\d+(?:[.,]\d+)?)[*]\(?(\d+(?:[.,]\d+)?)\)?\^\{?t\}?/i);
      if (!m) continue;
      const calculado = Number(m[1].replace(',', '.')) *
        Math.pow(Number(m[2].replace(',', '.')), dias);
      const distancias = linhas.map((l,i) => ({ i, dist: Math.abs(numero(l.nome) - calculado) }))
        .filter(v => Number.isFinite(v.dist)).sort((a,b) => a.dist - b.dist);
      if (distancias.length >= 2 && distancias[0].dist <= Math.max(.15, Math.abs(calculado)*.005) &&
          distancias[1].dist - distancias[0].dist > .05) return distancias[0].i;
    }
    return null;
  }

  function resolver(linhas) {
    const nomes = linhas.map(l => normal(l.nome).replace(/^[a-h]\s+/, ''));
    for (const g of [...S.gabaritos].reverse()) {
      const acertos = nomes.filter(n => g.alternativas.some(v => v === n || v.endsWith(' '+n))).length;
      if (acertos < Math.max(2, Math.ceil(nomes.length * .75))) continue;
      const indices = nomes.map((n,i) => n === g.correta || g.correta.endsWith(' '+n) ? i : -1)
        .filter(i => i !== -1);
      if (indices.length === 1) return { indice: indices[0], metodo: 'dados da questao' };
    }
    const valores = linhas.map(l => numero(l.nome));
    if (valores.every(v => v !== null)) {
      for (const fonte of formulas()) {
        if (!fonte.includes('=') || !/[xX]/.test(fonte)) continue;
        const verdadeiras = valores.map((v,i) => testarEquacao(fonte, v) === true ? i : -1)
          .filter(i => i >= 0);
        if (verdadeiras.length === 1) return { indice: verdadeiras[0], metodo: 'equacao exponencial' };
      }
      const crescimento = resolverCrescimento(linhas);
      if (crescimento !== null) return { indice: crescimento, metodo: 'crescimento exponencial' };
    }
    return null;
  }

  function clicarAlternativa(linha) {
    const alvo = linha.el.querySelector('input[type="radio"], [role="radio"], button, label') || linha.el;
    if (!alvo.isConnected) return false;
    alvo.click();
    return true;
  }
  function restaurar() {
    if (!S.visual) return;
    S.visual.card.remove();
    for (const linha of S.visual.linhas) {
      if (!linha.el.isConnected) continue;
      if (linha.display) linha.el.style.setProperty('display', linha.display, linha.prio);
      else linha.el.style.removeProperty('display');
    }
    S.visual = null;
  }
  function mostrarSoA(linhas, indice) {
    restaurar();
    const first = linhas[0].el;
    if (!first.parentElement) return;
    const card = document.createElement(first.tagName.toLowerCase() === 'li' ? 'li' : 'div');
    card.id = 'lb36-a';
    card.textContent = `A · ${linhas[indice].nome.replace(/^\s*[A-H]\s*[.):]?\s*/i, '')}`;
    card.style.cssText = 'padding:14px;margin:8px 0;border:2px solid #23a76c;'+
      'border-radius:10px;background:#e2fae9;color:#14452c;cursor:pointer;';
    card.addEventListener('click', () => clicarAlternativa(linhas[indice]));
    first.parentElement.insertBefore(card, first);
    S.visual = { card, linhas: linhas.map(({el}) => ({el,
      display: el.style.getPropertyValue('display'),
      prio: el.style.getPropertyPriority('display') })) };
    for (const linha of linhas) linha.el.style.setProperty('display', 'none', 'important');
  }

  function botao(ids, nomes) {
    for (const id of ids) {
      const el = document.querySelector(`[data-testid="${id}"]`);
      if (visivel(el)) return el;
    }
    return [...document.querySelectorAll('button')].find(el => visivel(el) &&
      !el.closest('#lb36-panel') && nomes.includes(normal(texto(el)))) || null;
  }
  const verificar = () => botao(['exercise-check-answer'], ['verificar','verificar resposta','check answer']);
  const proxima = () => botao(['exercise-next-question','exercise-next-question-button'],
    ['próxima questão','próximo','continuar','next question']);
  function feedback() {
    return [...document.querySelectorAll('[role="alert"], [role="status"], [aria-live], [data-testid*="feedback"]')]
      .filter(visivel).map(texto).join(' ');
  }
  function assinatura() {
    return formulas().join('|').slice(0,1000) + '|' + alternativas().map(l => l.nome).join('|');
  }
  function analisar() {
    restaurar();
    const linhas = alternativas();
    if (linhas.length < 2) {
      S.resposta = null;
      aviso('Nao identifiquei as alternativas desta tela.');
      return false;
    }
    const solucao = resolver(linhas);
    if (!solucao) {
      S.resposta = null;
      aviso(`Encontrei ${linhas.length} alternativas, mas nao consegui resolver. Formulas lidas: ${formulas().filter(s=>s.includes('=')).length}.`);
      return false;
    }
    const indice = solucao.indice;
    S.resposta = { letra: String.fromCharCode(65 + indice),
      valor: linhas[indice].nome.replace(/^\s*[A-H]\s*[.):]?\s*/i, ''),
      metodo: solucao.metodo };
    S.assinatura = assinatura();
    const clicou = clicarAlternativa(linhas[indice]);
    if (!clicou) { aviso('Identifiquei a resposta, mas nao consegui seleciona-la.'); return false; }
    mostrarSoA(linhas, indice);
    S.ultimo = Date.now();
    fase('selecionada', `Resposta ${S.resposta.letra} selecionada. Exibindo apenas A.`);
    return true;
  }
  function pausar(msg) { S.ativo = false; restaurar(); fase('parado', msg); }
  function tick() {
    if (!S.ativo || document.visibilityState === 'hidden') return;
    const agora = Date.now();
    if (agora - S.ultimo < 1200) return;
    if (S.etapa === 'parado') {
      if (!analisar()) pausar(S.mensagem);
      return;
    }
    if (S.etapa === 'selecionada') {
      const b = verificar();
      if (!b || b.disabled) {
        if (agora - S.desde > 10000) pausar('Nao encontrei Verificar habilitado.');
        return;
      }
      S.anterior = feedback();
      S.ultimo = agora;
      fase('verificando', 'Aguardando confirmacao do Khan Academy...');
      b.click();
    } else if (S.etapa === 'verificando') {
      const atual = feedback();
      if (atual !== S.anterior && /resposta correta|muito bem|parab[eé]ns|mandou bem|acertou|correct answer/i.test(atual)) {
        fase('correta', 'Acerto confirmado.');
      } else if (agora - S.desde > 15000) pausar('Nao houve confirmacao de acerto; automacao pausada.');
    } else if (S.etapa === 'correta') {
      const b = proxima();
      if (!b) return;
      restaurar();
      S.ultimo = agora;
      fase('mudando', 'Indo para proxima questao...');
      b.click();
    } else if (S.etapa === 'mudando') {
      if (assinatura() !== S.assinatura) fase('parado', 'Nova questao carregada.');
      else if (agora - S.desde > 20000) pausar('Proxima questao nao detectada.');
    }
  }

  function painel() {
    if (!document.body || document.getElementById('lb36-panel')) return;
    const p = document.createElement('aside');
    p.id = 'lb36-panel';
    p.style.cssText = 'position:fixed;top:70px;right:14px;z-index:2147483646;'+
      'width:290px;background:#143426;color:white;padding:14px;border-radius:12px;'+
      'font:13px Arial,sans-serif;box-shadow:0 5px 20px #0006;';
    const title = document.createElement('strong');
    title.textContent = 'KHAN HELPER 3.6';
    const resposta = document.createElement('p');
    resposta.id = 'lb36-resp';
    resposta.style.color = '#9afab9';
    const msg = document.createElement('p');
    msg.id = 'lb36-msg';
    function criar(nome, acao) {
      const b = document.createElement('button');
      b.textContent = nome;
      b.style.cssText = 'padding:9px 10px;margin:0 5px 5px 0;border:0;'+
        'border-radius:7px;background:#25bb7a;color:#062416;cursor:pointer;';
      b.addEventListener('click', acao);
      return b;
    }
    const start = criar('Iniciar', () => {
      if (S.ativo) { pausar('Pausado.'); }
      else { S.ativo = true; if (S.etapa === 'parado') fase('parado'); aviso('Automacao iniciada.'); }
    });
    start.id = 'lb36-start';
    const scan = criar('Analisar', () => analisar());
    const reset = criar('Restaurar', () => pausar('Interface restaurada.'));
    p.append(title, resposta, msg, start, scan, reset);
    document.body.appendChild(p);
    aviso(S.mensagem);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', painel, {once:true});
  } else painel();
  const timer = setInterval(() => {
    try { tick(); } catch (e) {
      console.error('[Khan Helper 3.6]', e);
      pausar('Erro: ' + e.message);
    }
  }, 800);
  window.addEventListener('pagehide', () => { clearInterval(timer); restaurar(); }, {once:true});
})();
